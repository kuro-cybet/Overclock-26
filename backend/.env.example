PROJECT_NAME=CampusOps
API_V1_STR=/api/v1
SECRET_KEY=campusops-secret-key-for-development-and-demo-purposes-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Connection (Switch to Supabase PostgreSQL or leave as SQLite)
# SQLite default:
DATABASE_URL=sqlite:///./data/campusops.db
# Supabase PostgreSQL (replace with your Supabase DB connection string):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# Google sign-in (Google Identity Services). The frontend uses the same client
# ID via VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Gmail delivery (Google OAuth lives in the send-campusops-email Edge Function)
# Generate GOOGLE_REFRESH_TOKEN with: python scripts/google_oauth_setup.py
# See documentation/gmail-oauth-setup.md for the full walkthrough.
# CAMPUSOPS_WEBHOOK_SECRET must match the Supabase Edge Function secret exactly.
CAMPUSOPS_WEBHOOK_SECRET=
# Optional dedicated secret for the /integrations/email/inbox webhook.
# Falls back to CAMPUSOPS_WEBHOOK_SECRET when empty.
CAMPUSOPS_INBOUND_SECRET=
# auto = Gmail when configured, otherwise simulate | gmail = require Gmail | simulated = never send
EMAIL_DELIVERY_MODE=auto
EMAIL_DELIVERY_TIMEOUT_SECONDS=15

# -------------------------------------------------------------
# Meta WhatsApp Cloud API Configuration
# -------------------------------------------------------------
# Permanent or system user access token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# Phone number ID from Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Custom secret verification token configured in Meta Webhook settings
WHATSAPP_VERIFY_TOKEN=campusops_verify_token_2026
# App Secret from Meta App Dashboard -> App Settings -> Basic (used to verify X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Meta Graph API version
WHATSAPP_API_VERSION=v21.0

# -------------------------------------------------------------
# Local Qwen AI Microservice Configuration (via ngrok HTTPS tunnel)
# -------------------------------------------------------------
# HTTPS URL provided by ngrok tunnel pointing to local AI service (e.g. https://xyz.ngrok-free.app)
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared authentication secret between CampusOps backend and AI service
AI_SERVICE_TOKEN=campusops_ai_secret_token_2026
# Model identifier
AI_MODEL=qwen-local
# Timeout in seconds for AI inference requests
AI_TIMEOUT_SECONDS=60

# -------------------------------------------------------------
# Web Search Configuration (for Q&A Grounding)
# -------------------------------------------------------------
# Provider: duckduckgo (default, no API key needed), tavily, or serpapi
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
