# CampusOps Frontend Environment Template
# Production Render backend: https://campusops-u6yt.onrender.com/api/v1
# Local development backend: http://127.0.0.1:8000/api/v1
VITE_API_URL=https://campusops-u6yt.onrender.com/api/v1

# Supabase Client Configuration
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# Google sign-in. Same OAuth client ID as the backend GOOGLE_CLIENT_ID.
# Authorize this site's origin in Google Cloud Console -> Credentials.
VITE_GOOGLE_CLIENT_ID=
