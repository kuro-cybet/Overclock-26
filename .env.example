# ==============================================================================
# CampusOps Environment Configuration Example
# ==============================================================================

PROJECT_NAME=CampusOps
API_V1_STR=/api/v1
SECRET_KEY=campusops-secret-key-for-development-and-demo-purposes-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Option 1: Local SQLite (Default for local testing and standalone runs)
DATABASE_URL=sqlite:///./data/campusops.db

# Option 2: Supabase PostgreSQL (Production / Cloud Database)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API Configuration
# ------------------------------------------------------------------------------
# WhatsApp System User Access Token generated from Meta Developer Portal
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token_here

# Phone Number ID from WhatsApp App Dashboard -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Custom Verification Token configured in Meta Webhooks settings
WHATSAPP_VERIFY_TOKEN=campusops_verify_token_2026

# Meta App Secret (used for verifying incoming X-Hub-Signature-256 HMAC-SHA256)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version
WHATSAPP_API_VERSION=v21.0

# When true, outbound messages are logged to the database/outbox without calling Meta
WHATSAPP_SIMULATE=false

